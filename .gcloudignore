# Allowlist: no .env files, test credentials, CRM data, Git history, or backups.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/
apps/*
!apps/api/
apps/api/*
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**
!apps/web/
apps/web/*
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/next-env.d.ts
!apps/web/next.config.ts
!apps/web/app/
!apps/web/app/**
!deploy/
deploy/*
!deploy/cloud-run/
deploy/cloud-run/*
!deploy/cloud-run/Dockerfile
!.dockerignore
!.gcloudignore

!postgres/
!postgres/schema.sql
!apps/web/public/
!apps/web/public/**
